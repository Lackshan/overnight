# Copy to .env for local dev. On Railway, set these as service variables.

# Public URL of the app, used for Stripe redirects.
# Local: http://localhost:8080 (or :5173 if you use the Vite dev server)
APP_URL=http://localhost:8080

# Shows the "View as" plan switcher and accepts X-Dev-Plan. Never true in production.
DEV_MODE=true

# --- Supabase (Project Settings → API / Database) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Only needed for older projects that still sign tokens with the legacy JWT secret.
SUPABASE_JWT_SECRET=
# Connect → Session pooler connection string. Leave empty to keep plans in memory.
DATABASE_URL=

# Same values for the browser (baked in at build time).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID of the one-off supporter payment (£2.49). The env var name comes
# from features.yaml (stripe_price_env).
STRIPE_PRICE_PRO=price_...

# --- Maps and data ---
# Restrict this key to your domains in the MapTiler dashboard.
VITE_MAPTILER_KEY=
# Optional: raises TfL rate limits.
TFL_APP_KEY=
# Postcodes to pre-build at startup so the first click is instant.
WARM_POSTCODES=E16AN,SW111AA,TW33AD,SE154QL,E162PX
# Optional: hold back police helicopter positions (e.g. 2m). Live by default.
POLICE_DELAY=0
# Record live flights into the shared flight history. Only one server should
# (the hosted one); set false on your laptop so aircraft aren't counted twice.
RECORD_HISTORY=true
